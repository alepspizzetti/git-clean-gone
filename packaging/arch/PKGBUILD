# Maintainer: Elder Torres
pkgname=git-clean-gone
pkgver=0.1.1
pkgrel=1
pkgdesc="Clean local Git branches whose remote tracking branch is gone"
arch=('x86_64')
url="https://github.com/eldertorres/git-clean-gone"
license=('MIT')
depends=('git')
makedepends=('cargo')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('672ff925fe0bbd3c01a2e75009685362b2399125b0e83037b81adce8a3a82b9d')

build() {
  cd "$pkgname-$pkgver"
  cargo build --release --locked
}

check() {
  cd "$pkgname-$pkgver"
  cargo test --locked
}

package() {
  cd "$pkgname-$pkgver"
  install -Dm755 "target/release/$pkgname" "$pkgdir/usr/bin/$pkgname"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
